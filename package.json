{
  "name": "ember-upgrade",
  "version": "0.1.0",
  "description": "Upgrades older Ember projects, step by step, to Vite, template tag, and the ember.nvp layout",
  "keywords": [
    "codemod",
    "ember",
    "upgrade"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:NullVoxPopuli/ember-upgrade.git"
  },
  "license": "MIT",
  "author": "NullVoxPopuli",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "bin": "./dist/cli.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rolldown -c",
    "format": "prettier . --write",
    "lint": "prettier . --check && tsc --noEmit",
    "test": "vitest run",
    "test:bundle": "pnpm build && node scripts/test-bundle.js"
  },
  "devDependencies": {
    "@oxc-parser/binding-wasm32-wasi": "0.130.0",
    "@types/node": "^24.0.0",
    "ember-estree": "^0.9.0",
    "ember-rfc176-data": "^0.3.18",
    "prettier": "^3.8.3",
    "release-plan": "^0.18.0",
    "rolldown": "^1.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">= 24"
  }
}
